# Copy this file to .env and fill in your real values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=youtube_analytics
DB_USER=postgres
DB_PASSWORD=postgresqlpass

# Path to the raw watch-history export (Google Takeout JSON)
RAW_DATA_PATH=data/watch-history.json

# Path where the cleaned, transformed CSV is written between ETL stages
STAGED_DATA_PATH=data/staged_watch_history.csv

# YouTube Data API v3 key (free: console.cloud.google.com)
# Leave blank to skip API enrichment and use keyword-based categorization
YOUTUBE_API_KEY=your_api_key_here
